// codegen/tests/fixtures/kitchen_sink.qz
//
// 打满生成器所有分支的压力输入（**不是**某个服务的真实 IDL）。
// 来历：echo.qz 只覆盖 8 种字段形态，我的第一版生成器在它上面 /W4 零警告，
// 但一上这份输入就炸出 4 个真 bug（packed tag 误用 kVarint、负数丢符号、
// repeated message 访问器名被格式化串顺序写坏、多级包名没转 a::b）。
// 所以它现在是回归基线：
//   * test_golden.py::TestFixtureCoverage 用纯 Python 检查生成物形状；
//   * CI 应该对它跑一次 cl /c（见 scripts/ci_*.ps1 的建议）。

syntax = "qz1";

package stress.test;

enum Level {
  L_NONE = 0;
  L_LOW  = 1;
  L_HIGH = 2;
}

message Inner {
  int32 v = 1;
}

message Everything {
  int32   f_int32   = 1;
  int64   f_int64   = 2;
  uint32  f_uint32  = 3;
  uint64  f_uint64  = 4;
  sint32  f_sint32  = 5;
  sint64  f_sint64  = 6;
  bool    f_bool    = 7;
  float   f_float   = 8;
  double  f_double  = 9;
  string  f_string  = 10;
  bytes   f_bytes   = 11;
  Level   f_enum    = 12;
  Inner   f_message = 13;

  repeated int32   r_int32   = 20;
  repeated int64   r_int64   = 21;
  repeated uint32  r_uint32  = 22;
  repeated uint64  r_uint64  = 23;
  repeated sint32  r_sint32  = 24;
  repeated sint64  r_sint64  = 25;
  repeated bool    r_bool    = 26;
  repeated float   r_float   = 27;
  repeated double  r_double  = 28;
  repeated string  r_string  = 29;
  repeated bytes   r_bytes   = 30;
  repeated Level   r_enum    = 31;
  repeated Inner   r_message = 32;

  repeated int32  u_int32  = 40 [packed = false];
  repeated double u_double = 41 [packed = false];
  repeated Level  u_enum   = 42 [packed = false];

  optional int32   o_int32   = 50;
  optional int64   o_int64   = 51;
  optional uint32  o_uint32  = 52;
  optional uint64  o_uint64  = 53;
  optional sint32  o_sint32  = 54;
  optional sint64  o_sint64  = 55;
  optional bool    o_bool    = 56;
  optional float   o_float   = 57;
  optional double  o_double  = 58;
  optional string  o_string  = 59;
  optional bytes   o_bytes   = 60;
  optional Level   o_enum    = 61;

  int32  d_int32  = 70 [default = -7];
  int64  d_int64  = 71 [default = -9223372036854775808];
  uint32 d_uint32 = 72 [default = 4294967295];
  uint64 d_uint64 = 73 [default = 18446744073709551615];
  double d_double = 74 [default = -1.5e-3];
  float  d_float  = 75 [default = 2.5];
  bool   d_bool   = 76 [default = true];
  string d_string = 77 [default = "hi \"there\"\n"];
  Level  d_enum   = 78 [default = 2];

  int32 deprecated_field = 80 [deprecated];
}

message Empty {
}

service Alpha {
  rpc Ping(Everything) returns (Empty);
  rpc Shared(Everything) returns (Everything) [timeout_ms = 250];
}

service Beta {
  rpc Shared(Empty) returns (Everything) [method_id = 0x0000ABCD, idempotent = false];
}
